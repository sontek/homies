Include /Users/john/.config/colima/ssh_config

Include /Users/john/.ssh/conductor_config

Include ~/.orbstack/ssh/config

# SSH over Session Manager
Host johnanderson@orb
   User johnanderson
   HostName orb
   ForwardAgent yes

Host i-* mi-*
   ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"

# Linux boxes: use the box's own systemd user ssh-agent (ssh-agent.socket +
# loginctl linger) instead of whatever SSH_AUTH_SOCK is or isn't set. The first
# use after a reboot asks for the passphrase and caches the key in the agent.
# No-op on macOS, where the socket doesn't exist. The path uses ssh's %i (local
# UID) rather than ${XDG_RUNTIME_DIR}: ssh rejects the whole file when that
# variable is unset, as on macOS, even though this block never matches there.
Match exec "test -S /run/user/%i/openssh_agent"
   IdentityAgent /run/user/%i/openssh_agent
   AddKeysToAgent yes

